<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicPlayer.Models"
             xmlns:controls="clr-namespace:MusicPlayer.Controls"
             xmlns:helpers="clr-namespace:MusicPlayer.Helpers"
             x:Class="MusicPlayer.Pages.ArtistPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Barra del modo de seleccion multiple: fila propia, encima de la lista. -->
        <controls:SelectionBar x:Name="Selection" Grid.Row="0" />


        <CollectionView x:Name="SongsView" Grid.Row="1" SelectionMode="None" Margin="8,0">

            <CollectionView.Header>
                <VerticalStackLayout Padding="4,8" Spacing="10">

                    <!-- Foto del grupo o compositor -->
                    <Border Style="{StaticResource ArtworkPlaceholder}" HeightRequest="180">
                        <Grid>
                            <Image Source="ic_artwork.png" Aspect="AspectFit" Margin="55" />
                            <Image x:Name="ArtistImage" Aspect="AspectFill" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="ArtistNameLabel" FontSize="22" FontAttributes="Bold" />
                            <Label x:Name="ArtistCountLabel" Style="{StaticResource HintText}" />
                        </VerticalStackLayout>

                        <!-- Renombrar el grupo en todas sus canciones de una vez. -->
                        <ImageButton Grid.Column="1"
                                     x:Name="RenameButton"
                                     Style="{StaticResource RowIconButton}"
                                     Source="ic_edit.png"
                                     Clicked="OnRenameGroupClicked" />

                        <!-- Vuelve a buscar foto y resena, saltandose lo ya consultado. -->
                        <ImageButton Grid.Column="2"
                                     x:Name="RefreshInfoButton"
                                     Style="{StaticResource RowIconButton}"
                                     Source="ic_refresh.png"
                                     Clicked="OnRefreshInfoClicked" />
                    </Grid>

                    <ActivityIndicator x:Name="InfoBusy" IsRunning="False" IsVisible="False" HorizontalOptions="Start" />

                    <!-- Resena recortada: la ficha es para escuchar musica, no para leer. El boton
                         despliega el texto entero y vuelve a recogerlo. -->
                    <Label x:Name="ArtistBioLabel"
                           Style="{StaticResource BodyText}"
                           IsVisible="False"
                           MaxLines="3"
                           LineBreakMode="TailTruncation" />
                    <ImageButton x:Name="BioToggleButton"
                                 Style="{StaticResource RowIconButton}"
                                 Source="ic_more.png"
                                 IsVisible="False"
                                 HorizontalOptions="Start"
                                 Clicked="OnToggleBioClicked" />
                    <Label x:Name="ArtistSourceLabel" Style="{StaticResource HintText}" IsVisible="False" />

                    <Border x:Name="LookupHintCard" Style="{StaticResource Card}" IsVisible="False">
                        <VerticalStackLayout Padding="14" Spacing="10">
                            <Label x:Name="LookupHintLabel" Style="{StaticResource HintText}" />
                            <Button x:Name="EnableLookupButton"
                                    Style="{StaticResource OutlineButton}"
                                    Clicked="OnEnableLookupClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                x:Name="PlayAllButton"
                                Style="{StaticResource PrimaryButton}"
                                ImageSource="ic_play_w.png"
                                ContentLayout="Left,8"
                                Clicked="OnPlayAllClicked" />
                        <Button Grid.Column="1"
                                x:Name="ShuffleAllButton"
                                Style="{StaticResource OutlineButton}"
                                ImageSource="ic_shuffle.png"
                                ContentLayout="Left,8"
                                Clicked="OnShuffleAllClicked" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SongRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                        <!-- La fila marcada se realza con el borde de marca; el estilo Card la deja lisa al desmarcarla. -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="48,*,Auto,48" ColumnSpacing="8" Padding="8,6">
                            <!-- Toque y pulsacion larga, los dos con los gestos nativos de Android: mantener
                                 pulsado inicia la seleccion multiple. No se usa TapGestureRecognizer porque su
                                 detector se come el evento y la pulsacion larga no llega a dispararse. -->
                            <Grid.Behaviors>
                                <helpers:ItemTouchBehavior Tapped="OnSongTapped" LongPressed="OnSongLongPressed" />
                            </Grid.Behaviors>
                            <Border Grid.Column="0" Style="{StaticResource ArtworkPlaceholder}" WidthRequest="44" HeightRequest="44">
                                <Grid>
                                    <Image Source="ic_artwork.png" Aspect="AspectFit" Margin="8" />
                                    <Image Source="{Binding Artwork}" Aspect="AspectFill" />
                                    <!-- Casilla de seleccion: tapa la caratula para que se vea de un vistazo que esta marcada. -->
                                    <Grid IsVisible="{Binding IsSelected}" BackgroundColor="{StaticResource Primary}">
                                        <Image Source="ic_check_w.png" Aspect="AspectFit" Margin="10" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Title}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource ItemSubtitle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource ItemSubtitle}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="3"
                                         Style="{StaticResource RowIconButton}"
                                         Source="ic_more.png"
                                         Clicked="OnSongMenuClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:MiniPlayerView x:Name="MiniPlayer" Grid.Row="2" />
    </Grid>

</ContentPage>
