    <Compile Include="..\Services\PlaylistService.cs" Link="App\Services\PlaylistService.cs" />
    <Compile Include="..\Services\QueueOrder.cs" Link="App\Services\QueueOrder.cs" />
    <Compile Include="..\Services\SettingsService.cs" Link="App\Services\SettingsService.cs" />
