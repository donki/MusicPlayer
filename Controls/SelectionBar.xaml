<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicPlayer.Controls.SelectionBar"
             IsVisible="False">

    <!-- Ocupa su propia fila, no flota sobre la lista: una barra superpuesta tapa el primer
         elemento justo cuando se acaba de marcar, que es el fallo que arrastra File Manager. -->
    <Border Margin="8,8,8,0"
            Padding="4"
            BackgroundColor="{StaticResource PrimaryDark}"
            StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource Black}" Opacity="0.30" Radius="10" Offset="0,3" />
        </Border.Shadow>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="0" VerticalOptions="Center">

            <ImageButton Grid.Column="0"
                         Style="{StaticResource HeaderIconButton}"
                         Source="ic_close_w.png"
                         Clicked="OnCloseClicked" />

            <Label x:Name="CountLabel"
                   Grid.Column="1"
                   Margin="4,0"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />

            <ImageButton x:Name="SelectAllButton"
                         Grid.Column="2"
                         Style="{StaticResource HeaderIconButton}"
                         Source="ic_check_w.png"
                         Clicked="OnSelectAllClicked" />

            <ImageButton x:Name="PlayButton"
                         Grid.Column="3"
                         Style="{StaticResource HeaderIconButton}"
                         Source="ic_play_w.png"
                         Clicked="OnPlayClicked" />

            <ImageButton x:Name="AddToPlaylistButton"
                         Grid.Column="4"
                         Style="{StaticResource HeaderIconButton}"
                         Source="ic_playlist_add_w.png"
                         Clicked="OnAddToPlaylistClicked" />

            <ImageButton x:Name="MoreButton"
                         Grid.Column="5"
                         Style="{StaticResource HeaderIconButton}"
                         Source="ic_more_w.png"
                         Clicked="OnMoreClicked" />
        </Grid>
    </Border>

</ContentView>
